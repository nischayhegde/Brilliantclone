{
  "name": "brilliantclone-functions",
  "description": "Cloud Functions backend for Trading Practice — secure OpenAI GPT-5.5 transport",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "copy:shared": "node scripts/copy-shared.mjs",
    "prebuild": "npm run copy:shared",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "pretest": "npm run copy:shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "openai": "^6.45.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
