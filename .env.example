# Firebase Web SDK config (PUBLIC — safe to expose in client bundles; access is
# enforced by Firestore security rules + enabled auth providers, not by secrecy).
# Copy to .env.local and fill from `firebase apps:sdkconfig web` / the MCP get-sdk-config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=brilliantclone.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=brilliantclone
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=743182846432
VITE_FIREBASE_APP_ID=
