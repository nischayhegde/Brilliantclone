# Firebase Web SDK config (PUBLIC — safe to expose in client bundles; access is
# enforced by Firestore security rules + enabled auth providers, not by secrecy).
# Copy to .env.local and fill from `firebase apps:sdkconfig web` / the MCP get-sdk-config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=brilliantclone.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=brilliantclone
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=743182846432
VITE_FIREBASE_APP_ID=

# Optional (local dev): set to "true" AND run `firebase emulators:start` to route the
# `aiRespond` callable to the local Functions emulator (127.0.0.1:5001). Leave unset to
# use the deployed backend. With AI offline, Practice still runs curated-only, no errors.
VITE_USE_EMULATORS=

# -----------------------------------------------------------------------------
# OpenAI GPT-5.5 — SERVER-SIDE ONLY. The OpenAI key is NOT a VITE_ var and must
# NEVER ship in the client bundle. It lives only as a Cloud Functions SECRET:
#
#   firebase functions:secrets:set OPENAI_API_KEY
#
# The `aiRespond` callable (functions/) reads it via defineSecret('OPENAI_API_KEY')
# and calls GPT-5.5 server-side behind auth + rate limits. Do not add OPENAI_API_KEY here.
#
# Prerequisites for LIVE model calls (NOT needed to build or run tests):
#   1. Enable the Blaze (pay-as-you-go) plan on the `brilliantclone` Firebase project
#      — Cloud Functions requires Blaze.
#   2. Set the secret above, then `firebase deploy --only functions` (or run the emulator).
# -----------------------------------------------------------------------------
